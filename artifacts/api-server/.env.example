# Database
DATABASE_URL=postgres://user:password@localhost:5432/vtwo_evolve

# Microsoft Graph — sendMail on behalf of START_NOW_FROM_EMAIL
# Required for Start Now form email delivery.
# If missing, submissions are still persisted to DB but no email is sent.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=your-client-secret-value

# Start Now form email recipients
# Defaults shown — override if needed.
START_NOW_TO_EMAIL=chris@vtwo.co
START_NOW_FROM_EMAIL=noreply@vtwo.co
